---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import { cx } from "@/utils/cx";
import defaultDocshubConfig from "docshub.config";

import Bitbucket from "@/components/icons/bitbucket.astro";
import Github from "@/components/icons/github.astro";
import Gitlab from "@/components/icons/gitlab.astro";

import SidebarCollapse from "@/components/layout/sidebar/sidebar-collapse";
import SidebarContent from "@/components/layout/sidebar/sidebar-content";

import { buttonVariants } from "@/components/ui/button";

import config from "docshub.config";
import ThemeToggle from "./themeToggle";
import DocshubBrand from "./docshubBrand.astro";
import { HistoryIcon } from "lucide-react";

const allDocs = await getCollection("docs");
const pathname = new URL(Astro.request.url).pathname;

const truncateStyles =
  "truncate max-w-[210px] sm:max-w-[300px] md:max-w-[500px] lg:max-w-[600px] xl:max-w-[800px] 2xl:max-w-full";
---

<nav
  class={cx(
    "sticky top-0 w-full z-50",
    "bg-gray-50/80 dark:bg-gray-900/80 backdrop-blur-md",
    "border-b border-gray-200 dark:border-gray-800",
  )}
>
  <div class="flex items-center justify-between h-16 px-3">
    <section class="flex items-center space-x-3 rtl:space-x-reverse">
      <SidebarCollapse client:only="react">
        <SidebarContent
          client:only="react"
          docs={allDocs}
          pathname={pathname}
          className="flex-1"
        />
        <p
          class="mt-2 pb-2 border-b border-dashed border-gray-200 dark:border-gray-800 flex items-center space-x-2 text-sm font-mono text-gray-600 dark:text-gray-400 tracking-tight"
        >
          <HistoryIcon size={14} />
          <span>v{defaultDocshubConfig.version}</span>
        </p>
        <DocshubBrand />
      </SidebarCollapse>
      {
        defaultDocshubConfig.logoUrl && (
          <Image
            width={24}
            height={24}
            src={defaultDocshubConfig.logoUrl}
            alt="Docshub Logo"
          />
        )
      }
      <a
        href="/"
        class="flex flex-col md:flex-row md:gap-2 max-w-full hover:opacity-70 transition-opacity items-center"
      >
        <p
          class={cx(
            "block text-lg font-semibold tracking-tight",
            truncateStyles,
          )}
        >
          {config.documentationTitle}
        </p>
      </a>
    </section>
    <section class="flex items-center">
      <div
        class="mr-3 hidden md:inline pr-4 border-r border-gray-300 dark:border-gray-800"
      >
        <span class="text-sm font-mono tracking-tight">v{config.version}</span>
      </div>
      <div class="flex items-center gap-1">
        {
          config.repository && (
            <a
              title={`${config.repository.type} repository`}
              href={config.repository.url}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                variant: "ghost",
                size: "icon",
              })}
            >
              {config.repository.type === "bitbucket" && (
                <Bitbucket height={22} width={22} />
              )}
              {config.repository.type === "github" && (
                <Github height={22} width={22} />
              )}
              {config.repository.type === "gitlab" && (
                <Gitlab height={22} width={22} />
              )}
            </a>
          )
        }
        <ThemeToggle client:load />
      </div>
    </section>
  </div>
</nav>
