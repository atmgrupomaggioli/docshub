---
import { cx } from "@/utils/cx";

interface Props {
  title?: string;
  className?: string;
  animate?: boolean;
}

const { className, animate, title } = Astro.props;
---

<div
  title={title}
  class="relative inline-flex overflow-hidden rounded-full p-px"
>
  {
    animate && (
      <span class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#c2c2c2_0%,#505050_50%,#bebebe_100%)]" />
    )
  }
  <span
    class={cx(
      "h-full w-full",
      "cursor-default",
      "bg-gray-100 dark:bg-gray-800",
      "border border-gray-300 dark:border-gray-700",
      "text-black dark:text-white text-xs",
      "inline-flex space-x-2 items-center justify-center rounded-full px-3 py-1",
      className,
    )}
  >
    <slot />
  </span>
</div>
