---
import { getCollection } from "astro:content";
import DocumentCard from "./documentCard.astro";

const allDocs = await getCollection("docs");
const latestPost = allDocs.sort((a, b) => {
  const dateA = new Date(b.data.publishDate).valueOf();
  const dateB = new Date(a.data.publishDate).valueOf();
  return dateA - dateB;
});
---

<section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  {
    latestPost
      .slice(0, 6)
      .map((post) => <DocumentCard documentSlug={post.slug} />)
  }
</section>
