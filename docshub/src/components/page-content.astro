---
import { cx } from "@/utils/cx";
import {
  ArrowUpRightIcon,
  CalendarIcon,
  ClockIcon,
  TagIcon,
  UserIcon,
} from "lucide-react";

import { convertCategory } from "@/utils/convertCategory";

import Badge from "@/components/ui/badge.astro";
import CopyToClipboard from "@/components/copyToClipboard";
import type { iDocsProperties } from "@/content/config";

interface Props {
  document: iDocsProperties;
  readingTime?: string;
  url: string;
}

const { document, url, readingTime } = Astro.props;
---

<div class={cx("flex flex-col px-4 py-4 md:px-8 md:py-8 container max-w-6xl")}>
  <header class="flex flex-col space-y-3 mb-4">
    <h1 class="tracking-tight text-3xl xl:text-4xl font-bold">
      {document.title}
    </h1>
    <p class="text-gray-700 dark:text-gray-300 text-pretty">
      {document.description}
    </p>
  </header>
  <div
    class="flex flex-col md:flex-row items-center w-full justify-between tracking-tight mb-6 border-b-2 border-gray-200 dark:border-gray-800 pb-3"
  >
    <div class="flex flex-row items-center space-x-1.5">
      <Badge title={`Category: ${document.category}`}>
        <TagIcon className="flex-shrink-0" size={14} strokeWidth={1.5} />
        <span>{convertCategory(document.category)}</span>
      </Badge>
      {
        document.publishDate && (
          <Badge title={`Published on: ${document.publishDate}`}>
            <CalendarIcon
              className="flex-shrink-0"
              size={14}
              strokeWidth={1.5}
            />
            <span>{document.publishDate}</span>
          </Badge>
        )
      }
      {
        readingTime && (
          <Badge title={`Read time: ${readingTime}`}>
            <ClockIcon className="flex-shrink-0" size={14} strokeWidth={1.5} />
            <span>{readingTime}</span>
          </Badge>
        )
      }
      {
        document.author &&
          (document.author.url ? (
            <a
              href={document.author.url}
              target="_blank"
              title={`Published by ${document.author.name}`}
              rel="noopener noreferrer"
            >
              <Badge className="cursor-pointer group hover:border-gray-600 dark:hover:border-gray-500 transition-colors">
                <UserIcon
                  className="flex-shrink-0"
                  size={14}
                  strokeWidth={1.5}
                />
                <span>{document.author.name}</span>
                <ArrowUpRightIcon
                  className="group-hover:text-black dark:group-hover:text-white text-gray-500 transition-colors"
                  size={12}
                />
              </Badge>
            </a>
          ) : (
            <Badge title={`Published by ${document.author.name}`}>
              <UserIcon className="flex-shrink-0" size={14} strokeWidth={1.5} />
              <span>{document.author.name}</span>
            </Badge>
          ))
      }
    </div>
    <CopyToClipboard client:only="react" btnText="Share" contentToCopy={url} />
  </div>
  <article
    class={cx(
      "text-pretty max-w-full",
      "prose prose-gray dark:prose-invert",
      "hover:prose-a:opacity-75",
      "md:prose-h1:text-4xl prose-h1:text-3xl prose-h1:font-semibold",
      "prose-headings:tracking-tight prose-heading:font-medium prose-headings:scroll-mt-16",
      "prose-a:decoration-gray-300 hover:prose-a:decoration-gray-400 dark:prose-a:decoration-gray-700 hover:dark:prose-a:decoration-gray-600 prose-a:underline-offset-[5px]",
      "prose-inline-code:rounded prose-inline-code:font-normal prose-inline-code:font-mono prose-inline-code:p-[2px] prose-inline-code:border dark:prose-inline-code:border-gray-800 prose-inline-code:border-gray-300 dark:prose-inline-code:bg-gray-800/50 prose-inline-code:bg-gray-200/50",
      "prose-code:break-words prose-code:text-wrap",
      "prose-pre:my-[3px] prose-pre:border prose-pre:border-gray-200 dark:prose-pre:border-gray-800",
      "prose-th:text-start",
    )}
  >
    <slot />
  </article>
</div>
