---
import { getEntry } from "astro:content";

import LayoutMain from "@/layouts/layoutMain.astro";
import LayoutDocs from "@/layouts/layoutDocs.astro";

const entry = await getEntry("docs", "getting-started");
const { Content, headings } = await entry.render();

const url = new URL(Astro.request.url).href;
---

<LayoutMain title={entry.data.title} description={entry.data.description}>
  <LayoutDocs document={entry.data} docUrl={url} headings={headings}>
    <Content />
  </LayoutDocs>
</LayoutMain>
