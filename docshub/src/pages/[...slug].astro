---
export const prerender = true;

import { type CollectionEntry, getCollection, render } from "astro:content";

import LayoutMain from "@/layouts/layoutMain.astro";
import LayoutDocs from "@/layouts/layoutDocs.astro";

// ✨ MDX Custom components
import Endpoint from "@/components/mdx/endpoint/endpoint.astro";
import UiBlock from "@/components/uiBlock.astro";
import DocumentCard from "@/components/documentCard.astro";
import Alert from "@/components/ui/alert.astro";

// 👩‍🚀 Astro components into MDX
import { Image } from "astro:assets";

// 📄 Get Document:
const post = Astro.props;

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: entry,
  }));
}
type Props = CollectionEntry<"docs">;

const url = new URL(Astro.request.url).href;

const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<LayoutMain title={post.data.title} description={post.data.description}>
  <LayoutDocs
    document={post.data}
    headings={headings}
    readingTime={remarkPluginFrontmatter.minutesRead}
    docUrl={url}
  >
    <Content components={{ Endpoint, Alert, UiBlock, DocumentCard, Image }} />
  </LayoutDocs>
</LayoutMain>
