---
import type { MarkdownHeading } from "astro";
import type { iDocsProperties } from "@/content.config";
import { ClientRouter } from "astro:transitions";

import Sidebar from "@/components/layout/sidebar/sidebar.astro";
import SidebarToc from "@/components/layout/sidebar-toc/sidebar-toc.astro";
import SidebarTocCollapse from "@/components/layout/sidebar-toc/sidebar-toc-collapse";

import PageContent from "@/components/page-content.astro";
import CopyToClipboardMDX from "@/components/mdx/plugins/copyToClipboard.astro";

export interface Props {
  document: iDocsProperties;
  docUrl: string;
  readingTime?: string;
  headings?: MarkdownHeading[];
}

const { document, docUrl, headings, readingTime } = Astro.props;
---

<ClientRouter />
<CopyToClipboardMDX />

<Sidebar />
<div class="xl:ml-64 grid grid-cols-1 xl:grid-cols-[1fr_240px]">
  <section class="block sm:block md:block lg:hidden">
    {
      headings && headings.length > 0 && (
        <SidebarTocCollapse headings={headings} client:load />
      )
    }
  </section>
  <PageContent document={document} url={docUrl} readingTime={readingTime}>
    <slot />
  </PageContent>
  <section>
    {headings && headings.length > 0 && <SidebarToc headings={headings} />}
  </section>
</div>

<script>
  /**
   * @params {HTMLCollectionOf<HTMLElement>} graphs
   */
  document.addEventListener("astro:page-load", () => {
    async function renderDiagrams(graphs) {
      const { default: mermaid } = await import("mermaid");
      const htmlClassList = document.documentElement.classList;
      const theme = htmlClassList.contains("dark") ? "dark" : "default";

      mermaid.initialize({
        startOnLoad: false,
        fontFamily: "var(--sans-font)",
        // @ts-ignore This works, but TS expects an enum for some reason
        theme: theme,
      });

      for (const graph of graphs) {
        const content = graph.querySelector(".mermaid-src").innerText;
        if (!content) continue;
        let svg = document.createElement("svg");
        const id = (svg.id = "mermaid-" + Math.round(Math.random() * 100000));
        graph.appendChild(svg);
        mermaid.render(id, content).then((result) => {
          graph.innerHTML = result.svg;
        });
      }
    }

    const graphs = document.getElementsByClassName("mermaid");
    if (document.getElementsByClassName("mermaid").length > 0) {
      renderDiagrams(graphs);
    }
  });
</script>
