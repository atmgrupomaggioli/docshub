{
  "name": "docshub",
  "version": "2.0.2",
  "type": "module",
  "description": "Create the workspace or create a new document in DocsHub.",
  "repository": {
    "type": "git",
    "url": "https://github.com/atmgrupomaggioli/docshub"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "license": "GPL-3.0",
  "keywords": [
    "docshub",
    "cli",
    "documentation"
  ],
  "bin": {
    "cli": "./dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsup && node ./dist/index.js",
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "link": "npm run build && npm link",
    "unlink": "npm unlink -g @docshub/cli"
  },
  "dependencies": {
    "@clack/prompts": "0.9.0",
    "chalk": "5.4.1",
    "date-fns": "4.1.0",
    "gradient-string": "3.0.0",
    "lucide-react": "0.503.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/gradient-string": "1.1.6",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.6.0",
    "eslint": "8.56.0",
    "prettier": "3.2.5",
    "tsup": "8.0.2",
    "typescript": "5.4.5"
  }
}
